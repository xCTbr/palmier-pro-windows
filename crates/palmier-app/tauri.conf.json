{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Palmier",
  "version": "0.0.2",
  "identifier": "io.palmier.desktop",
  "build": {
    "frontendDist": "../palmier-ui/web"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Video",
    "shortDescription": "Edit video by talking to your agent",
    "longDescription": "An AI-native video editor driven over MCP, running entirely on your own machine.",
    "licenseFile": "../../LICENSE",
    "resources": [],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
